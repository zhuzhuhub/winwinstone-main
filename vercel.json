{
  "buildCommand": "node scripts/build-seo-pages.js",
  "outputDirectory": "site",
  "framework": null,
  "redirects": [
    {
      "source": "/products/stone-sinks/(.*)",
      "destination": "/products/$1",
      "statusCode": 301
    },
    {
      "source": "/products/stone-tables/(.*)",
      "destination": "/products/$1",
      "statusCode": 301
    },
    {
      "source": "/products/stone-bathtubs/(.*)",
      "destination": "/products/$1",
      "statusCode": 301
    },
    {
      "source": "/products/stone-fireplaces/(.*)",
      "destination": "/products/$1",
      "statusCode": 301
    },
    {
      "source": "/products/stone-furniture/(.*)",
      "destination": "/products/$1",
      "statusCode": 301
    },
    {
      "source": "/products/marble-sinks/(.*)",
      "destination": "/products/$1",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
